#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
manifest="$repo_root/tools/soil-visualizer/Cargo.toml"

if [[ $# -gt 1 ]]; then
  echo "usage: tools/run-soil-visualizer [udp-port]" >&2
  exit 2
fi

# Always use the repository's pinned Rust toolchain. The system Rust on this
# Mac may be older than Macroquad's transitive dependencies require.
exec nix develop "$repo_root" --command bash -c '
  manifest="$1"
  shift
  cd /private/tmp
  exec cargo run --release --manifest-path "$manifest" -- "$@"
' bash "$manifest" "$@"
