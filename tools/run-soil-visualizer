#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
manifest="$repo_root/tools/soil-visualizer/Cargo.toml"

if [[ $# -gt 1 ]]; then
  echo "usage: tools/run-soil-visualizer [udp-port]" >&2
  exit 2
fi

cd /private/tmp
cargo run --release --manifest-path "$manifest" -- "$@"
