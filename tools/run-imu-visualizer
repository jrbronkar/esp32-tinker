#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
manifest="$repo_root/tools/imu-visualizer/Cargo.toml"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: tools/run-imu-visualizer /dev/cu.usbmodemXXXX | --udp [port]" >&2
  exit 2
fi

# Use the pinned Rust compiler, then build outside the repository so the
# ESP32-only target settings do not apply to this macOS application.
exec nix develop "$repo_root" --command bash -c '
  manifest="$1"
  shift
  cd /private/tmp
  exec cargo run --release --manifest-path "$manifest" -- "$@"
' bash "$manifest" "$@"
